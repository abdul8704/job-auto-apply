# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
JWT_SECRET=replace-with-a-long-random-string
# Emails (comma-separated) allowed to sign up after the first account
SIGNUP_ALLOWLIST=
# local (default) or s3
STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=ap-south-1
# Contact finding (optional). Without keys, contacts come from the posting and name-pattern guesses.
# Hunter.io free plan: https://hunter.io/api  Apollo.io: https://www.apollo.io/ (Settings > API keys)
HUNTER_API_KEY=
APOLLO_API_KEY=

# GitHub import: optional token for a higher rate limit
GITHUB_TOKEN=
# Email: console (log only) | smtp | ses
MAIL_BACKEND=console
MAIL_FROM=job-auto-apply <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
