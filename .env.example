# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
JWT_SECRET=replace-with-a-long-random-string
# Emails (comma-separated) allowed to sign up after the first account
SIGNUP_ALLOWLIST=
# local (default) or s3
STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=ap-south-1
# Contact finding (optional). Without keys, contacts come from the posting and name-pattern guesses.
# Hunter.io free plan: https://hunter.io/api  Apollo.io: https://www.apollo.io/ (Settings > API keys)
HUNTER_API_KEY=
APOLLO_API_KEY=
